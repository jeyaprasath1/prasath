<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drug Inventory Management</title>
    <style>
        /* Root styles for theming */
        :root {
            --primary-color: #3b82f6;
            --secondary-color: #1d4ed8;
            --bg-color: #f3f4f6;
            --text-color: #374151;
            --card-bg: #ffffff;
            --border-radius: 12px;
            --box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);
            --font-family: 'Inter', Arial, sans-serif;
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            margin: 0;
            padding: 0;
            color: var(--text-color);
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 40px auto;
            background: var(--card-bg);
            padding: 30px;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
        }

        h1 {
            text-align: center;
            color: var(--primary-color);
            margin-bottom: 30px;
            font-size: 2rem;
        }

        .section {
            margin-bottom: 40px;
        }

        .section h2 {
            color: var(--secondary-color);
            font-size: 1.75rem;
            margin-bottom: 15px;
            border-bottom: 2px solid var(--primary-color);
            padding-bottom: 5px;
        }

        label {
            display: block;
            margin: 15px 0 5px;
            font-weight: 600;
        }

        input[type="text"],
        input[type="number"],
        input[type="date"],
        button {
            width: 100%;
            padding: 12px;
            margin-top: 5px;
            border: 1px solid #d1d5db;
            border-radius: var(--border-radius);
            font-size: 1rem;
            box-sizing: border-box;
        }

        button {
            background-color: var(--primary-color);
            color: #ffffff;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }

        button:hover {
            background-color: var(--secondary-color);
            transform: scale(1.02);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            box-shadow: var(--box-shadow);
        }

        table, th, td {
            border: 1px solid #d1d5db;
        }

        th {
            background-color: var(--primary-color);
            color: #ffffff;
            padding: 12px;
            text-align: left;
        }

        td {
            padding: 12px;
            text-align: left;
            background-color: var(--card-bg);
        }

        /* Card styles for section */
        .section {
            background: var(--card-bg);
            padding: 20px;
            border-radius: var(--border-radius);
            box-shadow: var(--box-shadow);
        }

        /* Mobile-friendly styles */
        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }

            h1 {
                font-size: 1.5rem;
            }

            input[type="text"], 
            input[type="number"], 
            input[type="date"], 
            button {
                font-size: 0.9rem;
                padding: 10px;
            }

            th, td {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Drug Inventory Management</h1>

        <!-- Add Drug Section -->
        <div class="section" id="add-drug-section">
            <h2>New Drug</h2>
            <form id="add-drug-form">
                <label for="drug-name">Drug Name:</label>
                <input type="text" id="drug-name" name="drug_name" required>

                <label for="drug-code">Drug Code:</label>
                <input type="text" id="drug-code" name="drug_code" required>

                <label for="quantity">Quantity:</label>
                <input type="number" id="quantity" name="quantity" required>

                <label for="price">Price per Unit:</label>
                <input type="number" id="price" name="price" required>

                <label for="expiry-date">Expiry Date:</label>
                <input type="date" id="expiry-date" name="expiry_date" required>

                <button type="submit">Add Drug</button>
            </form>
        </div>

        <!-- View Inventory Section -->
        <div class="section" id="inventory-section">
            <h2>Current Inventory</h2>
            <table id="inventory-table">
                <thead>
                    <tr>
                        <th>Drug Name</th>
                        <th>Drug Code</th>
                        <th>Quantity</th>
                        <th>Price per Unit</th>
                        <th>Expiry Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Inventory items will be populated here dynamically -->
                </tbody>
            </table>
        </div>

        <!-- Supplier Details Section -->
        <div class="section" id="supplier-section">
            <h2>Supplier Details</h2>
            <form id="add-supplier-form">
                <label for="supplier-name">Supplier Name:</label>
                <input type="text" id="supplier-name" name="supplier_name" required>

                <label for="contact-info">Contact Information:</label>
                <input type="text" id="contact-info" name="contact_info" required>

                <button type="submit">Add Supplier</button>
            </form>

            <h3>Registered Suppliers</h3>
            <table id="supplier-table">
                <thead>
                    <tr>
                        <th>Supplier Name</th>
                        <th>Contact Information</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Supplier data will be populated here dynamically -->
                </tbody>
            </table>
        </div>
    </div>

    <script src="/js/inventory.js"></script>
</body>
</html>
