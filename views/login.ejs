<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEDIX - Login</title>
    <link rel="shortcut icon" href="https://cdn.pixabay.com/photo/2015/02/02/18/59/health-621356_1280.jpg" type="image/x-icon">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.3/font/bootstrap-icons.min.css" rel="stylesheet">      
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="container">
        <h1>MEDIX-login</h1>
        <h2>Sign In</h2>
        <form id="loginForm" action="/login" method="post">
            <div class="input-container">
                <i class="bi bi-person-fill"></i>
                <input type="text" name="username" id="username" placeholder="Username" required>
            </div>
            <div class="input-container">
                <i class="bi bi-lock-fill"></i>
                <input type="password" name="password" id="password" placeholder="Password" required>
            </div>
            <div class="checkbox-container">
                <label>
                    <input type="checkbox" id="remember">
                    Remember me
                </label>
                <a href="/forgot-password" class="forgot">Forgot password?</a>
            </div>
            <button id="submit" class="login-btn">Login</button>
            <p class="register-link">Don't have an account? <a href="/register">Make a new account</a></p>
        </form>
        </div>
    <script src="/js/login.js"></script>
</body>
</html>
