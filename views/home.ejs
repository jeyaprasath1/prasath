<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MEDIX - Drug Tracking System</title>
    <link rel="shortcut icon" href="https://cdn.pixabay.com/photo/2015/02/02/18/59/health-621356_1280.jpg" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/home.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            color: #333;
            line-height: 1.6;
        }

        .header {
            background-color: #4CAF50;
            padding: 15px;
            text-align: center;
            color: white;
        }

        .sidebar {
            width: 250px;
            height: 100%;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #333;
            padding-top: 20px;
            color: white;
        }

        .sidebar ul {
            list-style-type: none;
        }

        .sidebar ul li {
            padding: 10px;
            text-align: left;
        }

        .sidebar ul li a {
            color: white;
            text-decoration: none;
            display: block;
            padding: 8px;
            border-radius: 5px;
        }

        .sidebar ul li a:hover {
            background-color: #575757;
        }

        .main-content {
            margin-left: 260px;
            padding: 20px;
        }

        .notifications {
            margin-top: 30px;
            padding: 20px;
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .notifications h2 {
            font-size: 1.5rem;
            margin-bottom: 15px;
        }

        .notification-item {
            padding: 20px;
            border-top: 1px solid #ddd;
            margin-bottom: 10px;
            opacity: 0;
            animation: fadeIn 1s forwards;
        }

        .notification-item:first-child {
            border-top: none;
        }

        .notification-link {
            color: #4CAF50;
            text-decoration: none;
            font-weight: bold;
        }

        .notification-link:hover {
            text-decoration: underline;
        }

        /* Fade-in animation */
        @keyframes fadeIn {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }

        /* Add a style for the "Add Notification" button */
        .add-notification-btn {
            margin-top: 20px;
            padding: 10px 20px;
            background-color: #4CAF50;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .add-notification-btn:hover {
            background-color: #45a049;
        }

        /* Modal styles */
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgb(0, 0, 0);
            background-color: rgba(0, 0, 0, 0.4);
            padding-top: 60px;
        }

        .modal-content {
            background-color: #fefefe;
            margin: 5% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <!-- Header with Language Selection -->
    <div class="header">
        <h1>MEDIX - Drug Tracking System</h1>
        <!-- Language Selection Dropdown -->
        <div class="language-selection">
            <select id="language-dropdown" onchange="changeLanguage()" class="form-control">
                <option value="en-US" selected>English (United States)</option>
                <option value="ta">தமிழ் (Tamil)</option>
                <option value="hi">हिन्दी (Hindi)</option>
                <option value="kn">ಕನ್ನಡ (Kannada)</option>
                <option value="es">Español (Spanish)</option>
                <option value="fr">Français (French)</option>
                <option value="de">Deutsch (German)</option>
                <option value="zh">中文 (Chinese)</option>
                <option value="jp">日本語 (Japanese)</option>
            </select>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="sidebar">
        <h2>Menu</h2>
        <ul>
            <li><a href="/home"><i class="fa fa-home" aria-hidden="true"></i><span class="sidebar-item">Dashboard</span></a></li>
            <li><a href="/inventory"><i class="fas fa-boxes"></i><span class="sidebar-item">Inventory Management</span></a></li>
            <li><a href="/realtime"><i class="fas fa-map-marker-alt"></i><span class="sidebar-item">Real-Time Tracking</span></a></li>
            <li><a href="/order"><i class="fas fa-shopping-cart"></i><span class="sidebar-item">Order Payment</span></a></li>
            <li><a href="/card"><i class="fa-solid fa-cart-shopping"></i><span class="sidebar-item">Order Card</span></a></li>
            <li><a href="/manufacture"><i class="fa-solid fa-store"></i><span class="sidebar-item">Manufacture</span></a></li>
            <li><a href="/analytics"><i class="fas fa-chart-line"></i><span class="sidebar-item">Analytics & Reports</span></a></li>
            <li><a href="/setting"><i class="fas fa-cog"></i><span class="sidebar-item">Settings</span></a></li>
            <li><a href="/index.html"><i class="fa fa-sign-out" aria-hidden="true"></i><span class="sidebar-item">Logout</span></a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <div class="container">
            <h1>Dashboard</h1>
            <div class="row">
                <!-- Dashboard Cards -->
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card p-4 text-center">
                        <i class="fas fa-capsules"></i>
                        <h3>Total Stock</h3>
                        <p id="totalStock">2,345 Items</p>
                        <button class="total"><a href="/stock">Total Check</a></button>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card p-4 text-center">
                        <i class="fas fa-truck"></i>
                        <h3>In Transit</h3>
                        <p id="shipments">56 Shipments</p>
                        <button class="transit"><a href="/transit">Transit Check</a></button>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card p-4 text-center">
                        <i class="fas fa-exclamation-triangle"></i>
                        <h3>Alerts</h3>
                        <p id="alerts">5 Expired Items</p>
                        <button class="alerts"><a href="/alerts">Stock Alerts</a></button>
                    </div>
                </div>
            </div>

            <!-- Notifications Section -->
            <div class="notifications">
                <h2><i class="fa-solid fa-bell"></i>User Notifications</h2>
                <div class="notification-item">
                    Order #12345 has been shipped.
                    <a href="/order" class="notification-link">View Order</a>
                </div>
                <div class="notification-item">
                    5 Expired Items in your inventory.
                    <a href="/inventory" class="notification-link">Check Inventory</a>
                </div>
                <div class="notification-item">
                    New stock of 'MedX' drug available.
                    <a href="/inventory" class="notification-link">View Stock</a>
                </div>
            </div>
            
            <!-- Add Notification Modal -->
            <button class="add-notification-btn" onclick="openModal()">Add Notification</button>

            <div id="notificationModal" class="modal">
                <div class="modal-content">
                    <span class="close" onclick="closeModal()">&times;</span>
                    <h2>Add New Notification</h2>
                    <textarea id="notificationText" class="form-control" rows="3" placeholder="Enter your notification here..."></textarea>
                    <br>
                    <button class="btn btn-primary" onclick="addNotification()">Add Notification</button>
                </div>
            </div>
        </div>
    </div>

    <!-- JavaScript -->
    <script>
        // Function to open the modal
        function openModal() {
            document.getElementById("notificationModal").style.display = "block";
        }

        // Function to close the modal
        function closeModal() {
            document.getElementById("notificationModal").style.display = "none";
        }

        // Function to add a notification
        function addNotification() {
            var notificationText = document.getElementById("notificationText").value;
            if (notificationText.trim() === "") {
                alert("Please enter a valid notification.");
                return;
            }

            // Add the new notification dynamically
            var notificationsContainer = document.querySelector(".notifications");
            var newNotification = document.createElement("div");
            newNotification.classList.add("notification-item");
            newNotification.innerHTML = notificationText + ' <a href="/inventory" class="notification-link">View Details</a>';
            notificationsContainer.insertBefore(newNotification, notificationsContainer.children[0]);

            // Save the new notification to localStorage
            saveNotificationToLocalStorage(notificationText);

            // Clear the textarea and close the modal
            document.getElementById("notificationText").value = "";
            closeModal();
        }

        // Function to save notification to localStorage
        function saveNotificationToLocalStorage(notificationText) {
            let notifications = JSON.parse(localStorage.getItem("notifications")) || [];
            notifications.unshift(notificationText); // Add new notification to the start of the array
            localStorage.setItem("notifications", JSON.stringify(notifications)); // Save back to localStorage
        }

        // Function to load notifications from localStorage on page load
        function loadNotifications() {
            let notifications = JSON.parse(localStorage.getItem("notifications")) || [];
            var notificationsContainer = document.querySelector(".notifications");

            // Loop through the notifications and display them
            notifications.forEach(function(notificationText) {
                var newNotification = document.createElement("div");
                newNotification.classList.add("notification-item");
                newNotification.innerHTML = notificationText + ' <a href="" class="notification-link">View Details</a>';
                notificationsContainer.appendChild(newNotification);
            });
        }

        // Load notifications on page load
        window.onload = loadNotifications;
    </script>
<script src="/js/home.js"></script>
</body>

</html>
