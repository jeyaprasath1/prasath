<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Drug Inventory Analytics</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            margin: 0;
            padding: 20px;
            background-color: #f8f9fa;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        .summary {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
        }

        .summary div {
            background: #007bff;
            color: white;
            padding: 20px;
            border-radius: 8px;
            width: 30%;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        table,
        th,
        td {
            border: 1px solid #ddd;
        }

        th,
        td {
            padding: 10px;
            text-align: center;
        }

        th {
            background-color: #f2f2f2;
        }

        .chart-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
        }

        .report-button {
            display: block;
            margin: 20px auto;
            padding: 10px 20px;
            background-color: #28a745;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }

        .report-button:hover {
            background-color: #218838;
        }

        .add-order-button {
            display: block;
            margin: 20px auto;
            padding: 10px 20px;
            background-color: #007bff;
            color: white;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 16px;
        }

        .add-order-button:hover {
            background-color: #0056b3;
        }

        .delete-button {
            background-color: #dc3545;
            color: white;
            padding: 5px 10px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .delete-button:hover {
            background-color: #c82333;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script> <!-- Include jsPDF -->
</head>

<body>

    <h1>Drug Inventory Analytics</h1>

    <div class="summary">
        <div>
            <h2 id="total-products">0</h2>
            <p>Total Products</p>
        </div>
        <div>
            <h2 id="total-orders">0</h2>
            <p>Total Orders</p>
        </div>
        <div>
            <h2 id="total-sales">₹0.00</h2>
            <p>Total Sales</p>
        </div>
    </div>

    <h2>Order Details</h2>

    <button class="add-order-button" id="add-order">Add Order</button>

    <table id="order-table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody id="order-body">
            <!-- Dynamic order rows will be inserted here -->
        </tbody>
    </table>

    <div class="chart-container">
        <canvas id="salesChart"></canvas>
    </div>

    <button class="report-button" id="generate-report">Generate Report</button>

    <script>
        const orderTableBody = document.getElementById("order-body");
        const totalProducts = document.getElementById("total-products");
        const totalOrders = document.getElementById("total-orders");
        const totalSales = document.getElementById("total-sales");

        // Retrieve orders from localStorage (if any)
        let orders = JSON.parse(localStorage.getItem("orders")) || [];

        // Function to add a new order
        function addOrder() {
            const productName = prompt("Enter product name:");
            const quantity = parseInt(prompt("Enter quantity:"));
            const price = parseFloat(prompt("Enter price per unit:"));

            if (productName && !isNaN(quantity) && !isNaN(price)) {
                const total = quantity * price;
                const order = {
                    productName,
                    quantity,
                    price,
                    total
                };
                orders.push(order);
                // Store updated orders in localStorage
                localStorage.setItem("orders", JSON.stringify(orders));
                updateOrderTable();
                updateSummary();
                updateChart();
            } else {
                alert("Please enter valid order details.");
            }
        }

        // Function to update the order table
        function updateOrderTable() {
            orderTableBody.innerHTML = ""; // Clear the table body
            orders.forEach((order, index) => {
                const row = document.createElement("tr");
                row.innerHTML = `
                    <td>${order.productName}</td>
                    <td>${order.quantity}</td>
                    <td>₹${order.price}</td>
                    <td>₹${order.total}</td>
                    <td><button class="delete-button" onclick="deleteOrder(${index})">Delete</button></td>
                `;
                orderTableBody.appendChild(row);
            });
        }

        // Function to delete an order
        function deleteOrder(index) {
            // Remove the order from the orders array
            orders.splice(index, 1);
            // Update localStorage with the new orders list
            localStorage.setItem("orders", JSON.stringify(orders));
            updateOrderTable();
            updateSummary();
            updateChart();
        }

        // Function to update the summary
        function updateSummary() {
            const totalOrdersCount = orders.length;
            const totalProductsCount = orders.reduce((sum, order) => sum + order.quantity, 0);
            const totalSalesAmount = orders.reduce((sum, order) => sum + order.total, 0);

            totalOrders.textContent = totalOrdersCount;
            totalProducts.textContent = totalProductsCount;
            totalSales.textContent = `₹${totalSalesAmount.toFixed(2)}`;
        }

        // Function to update the sales chart based on orders
        function updateChart() {
            const totalSalesAmount = orders.reduce((sum, order) => sum + order.total, 0);

            // Update chart data
            salesChart.data.datasets[0].data = [totalSalesAmount];
            salesChart.update();
        }

        // Function to generate and download the PDF report
        function generatePDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            // Add title
            doc.setFontSize(18);
            doc.text("Drug Inventory Report", 20, 20);

            // Add summary details
            doc.setFontSize(12);
            doc.text(`Total Products: ${totalProducts.textContent}`, 20, 30);
            doc.text(`Total Orders: ${totalOrders.textContent}`, 20, 40);
            doc.text(`Total Sales: ₹${totalSales.textContent.replace('₹', '')}`, 20, 50);

            // Add order details table
            doc.autoTable({
                startY: 60,
                head: [['Product Name', 'Quantity', 'Price', 'Total']],
                body: orders.map(order => [order.productName, order.quantity, `₹${order.price}`, `₹${order.total}`]),
            });

            // Save the generated PDF
            doc.save('drug_inventory_report.pdf');
        }

        // Event listener for adding a new order
        document.getElementById("add-order").addEventListener("click", addOrder);

        // Initialize the chart (this is just a placeholder chart)
        const ctx = document.getElementById('salesChart').getContext('2d');
        const salesChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Sales'],
                datasets: [{
                    label: 'Total Sales',
                    data: [0], // Placeholder data
                    backgroundColor: '#007bff',
                }]
            }
        });

        // Event listener for generating the report (PDF)
        document.getElementById("generate-report").addEventListener("click", generatePDF);

        // Update the table, summary, and chart on page load
        updateOrderTable();
        updateSummary();
        updateChart();

    </script>
</body>

</html>
